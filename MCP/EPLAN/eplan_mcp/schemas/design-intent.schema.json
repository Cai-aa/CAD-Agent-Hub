{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EPLAN design intent, independent of native database IDs",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "devices", "connections"],
  "properties": {
    "schema_version": {"const": "eplan-design-intent-1"},
    "supply": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "conductors": {"type": "array", "uniqueItems": true, "items": {"enum": ["L1", "L2", "L3", "N", "PE"]}},
        "line_voltage_v": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "phase_voltage_v": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "frequency_hz": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "devices": {
      "type": "array", "minItems": 1, "maxItems": 2000,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["tag", "kind", "ports"],
        "properties": {
          "tag": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^:]+$"},
          "kind": {"enum": ["plc", "motor", "terminal", "psu", "drive", "relay", "protective", "button", "other"]},
          "description_zh": {"type": "string", "maxLength": 1000},
          "part_number": {"type": ["string", "null"], "maxLength": 100},
          "ports": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/port"}},
          "io_groups": {"type": "array", "maxItems": 100, "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "channels", "common_port", "type"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
              "common_port": {"type": "string"}, "supply_port": {"type": "string"},
              "common_conductor": {"enum": ["DC24", "DC0", "TBD"]},
              "type": {"enum": ["PNP", "NPN", "relay", "input", "TBD"]}
            }
          }}
        }
      }
    },
    "connections": {"type": "array", "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "from", "to"],
      "properties": {"id": {"type": "string", "minLength": 1}, "from": {"type": "string"}, "to": {"type": "string"}}
    }},
    "intentional_bonds": {"type": "array", "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false, "required": ["connection_id", "reason"],
      "properties": {"connection_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}
    }},
    "required_paths": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/pair"}},
    "forbidden_pairs": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/pair"}},
    "forward_reverse": {
      "type": "object", "additionalProperties": false,
      "required": ["forward_output", "reverse_output", "mutual_exclusion", "restart_requires_new_start_edge", "reversal_requires_standstill"],
      "properties": {
        "forward_output": {"type": "string"}, "reverse_output": {"type": "string"},
        "mutual_exclusion": {"type": "boolean"}, "restart_requires_new_start_edge": {"type": "boolean"},
        "reversal_requires_standstill": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
    "port": {
      "type": "object", "additionalProperties": false, "required": ["id", "conductor"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^:]+$"},
        "conductor": {"enum": ["L1", "L2", "L3", "N", "PE", "DC24", "DC0", "SIGNAL", "U", "V", "W", "FE", "TBD"]},
        "physical_pin": {"type": ["string", "null"], "maxLength": 100},
        "required": {"type": "boolean"}, "max_connections": {"type": "integer", "minimum": 1, "maximum": 100},
        "plc_address": {"type": "string", "pattern": "^%?[IQ][0-9]+\\.[0-7]$"}
      }
    }
  }
}
